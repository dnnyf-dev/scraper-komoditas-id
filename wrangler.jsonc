{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komoditas-id-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  // WAJIB agar data live tersimpan (Cache API tidak jalan di *.workers.dev):
  //   npx wrangler kv namespace create STATE   -> salin id ke bawah, lalu hapus tanda //
  // "kv_namespaces": [{ "binding": "STATE", "id": "ISI_ID_KV_DI_SINI" }],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
